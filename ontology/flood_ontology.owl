<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/flood"
         xmlns="http://example.org/flood#">

<owl:Ontology rdf:about="http://example.org/flood"/>

<owl:ObjectProperty rdf:about="#servesWard">
  <rdfs:domain rdf:resource="#PumpStation"/>
  <rdfs:range rdf:resource="#Ward"/>
  <owl:inverseOf rdf:resource="#isServedBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isServedBy">
  <rdfs:domain rdf:resource="#Ward"/>
  <rdfs:range rdf:resource="#PumpStation"/>
  <owl:inverseOf rdf:resource="#servesWard"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#locatedIn">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Infrastructure"/>
        <rdf:Description rdf:about="#Facility"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Ward"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#flowsInto">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#StormwaterDrain"/>
        <rdf:Description rdf:about="#WaterBody"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#WaterBody"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAlertLevel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Ward"/>
  <rdfs:range rdf:resource="#RainfallAlertLevel"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#causes">
  <rdfs:domain rdf:resource="#HeavyRainfall"/>
  <rdfs:range rdf:resource="#FloodEvent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#affects">
  <rdfs:domain rdf:resource="#FloodEvent"/>
  <rdfs:range rdf:resource="#Ward"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inundates">
  <rdfs:domain rdf:resource="#FloodEvent"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Road"/>
        <rdf:Description rdf:about="#Subway"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#evacuatesTo">
  <rdfs:domain rdf:resource="#Ward"/>
  <rdfs:range rdf:resource="#ReliefCamp"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#deployedIn">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#PortablePump"/>
        <rdf:Description rdf:about="#RescueBoat"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Ward"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#managedBy">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Facility"/>
        <rdf:Description rdf:about="#PumpStation"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Officer"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#partOf">
  <rdfs:domain rdf:resource="#Pump"/>
  <rdfs:range rdf:resource="#PumpStation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#issuedFor">
  <rdfs:domain rdf:resource="#EvacuationOrder"/>
  <rdfs:range rdf:resource="#Ward"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasElevationM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Ward"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPopulation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Ward"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasAtRiskPopulation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Ward"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCapacity">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ReliefCamp"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPumpingCapacityLps">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Pump"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasRainfallMm">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#HeavyRainfall"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasThresholdMm">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RainfallAlertLevel"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasWaterLevelM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#WaterBody"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDangerLevelM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#WaterBody"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#isOperational">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PumpStation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPhone">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Officer"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#GeographicArea">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Ward">
  <rdfs:subClassOf rdf:resource="#GeographicArea"/>
  <owl:disjointWith rdf:resource="#WaterBody"/>
</owl:Class>

<owl:Class rdf:about="#LowLyingWard">
  <rdfs:subClassOf rdf:resource="#Ward"/>
  <owl:disjointWith rdf:resource="#HighGroundWard"/>
</owl:Class>

<owl:Class rdf:about="#HighGroundWard">
  <rdfs:subClassOf rdf:resource="#Ward"/>
</owl:Class>

<owl:Class rdf:about="#WaterBody">
  <rdfs:subClassOf rdf:resource="#GeographicArea"/>
</owl:Class>

<owl:Class rdf:about="#River">
  <rdfs:subClassOf rdf:resource="#WaterBody"/>
</owl:Class>

<owl:Class rdf:about="#Canal">
  <rdfs:subClassOf rdf:resource="#WaterBody"/>
</owl:Class>

<owl:Class rdf:about="#Reservoir">
  <rdfs:subClassOf rdf:resource="#WaterBody"/>
</owl:Class>

<owl:Class rdf:about="#Infrastructure">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#PumpStation">
  <rdfs:subClassOf rdf:resource="#Infrastructure"/>
</owl:Class>

<owl:Class rdf:about="#StormwaterDrain">
  <rdfs:subClassOf rdf:resource="#Infrastructure"/>
</owl:Class>

<owl:Class rdf:about="#Road">
  <rdfs:subClassOf rdf:resource="#Infrastructure"/>
</owl:Class>

<owl:Class rdf:about="#Subway">
  <rdfs:subClassOf rdf:resource="#Infrastructure"/>
</owl:Class>

<owl:Class rdf:about="#Facility">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ReliefCamp">
  <rdfs:subClassOf rdf:resource="#Facility"/>
  <owl:disjointWith rdf:resource="#Hospital"/>
</owl:Class>

<owl:Class rdf:about="#Hospital">
  <rdfs:subClassOf rdf:resource="#Facility"/>
</owl:Class>

<owl:Class rdf:about="#Resource">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Pump">
  <rdfs:subClassOf rdf:resource="#Resource"/>
  <owl:disjointWith rdf:resource="#RescueBoat"/>
</owl:Class>

<owl:Class rdf:about="#PortablePump">
  <rdfs:subClassOf rdf:resource="#Pump"/>
</owl:Class>

<owl:Class rdf:about="#RescueBoat">
  <rdfs:subClassOf rdf:resource="#Resource"/>
</owl:Class>

<owl:Class rdf:about="#Officer">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#RainfallAlertLevel">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#FloodEvent">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#EvacuationOrder">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#HeavyRainfall">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ServedWard">
  <rdfs:subClassOf rdf:resource="#Ward"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Ward"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#isServedBy"/>
          <owl:someValuesFrom rdf:resource="#PumpStation"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#UnprotectedWard">
  <rdfs:subClassOf rdf:resource="#Ward"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Ward"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#isServedBy"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#PumpStation"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#isOperational"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#OperationalPumpStation">
  <rdfs:subClassOf rdf:resource="#PumpStation"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#PumpStation"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#isOperational"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

